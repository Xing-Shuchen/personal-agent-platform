{
  "id": "pap-librarian-intake",
  "name": "PAP Librarian Image Intake",
  "description": "Accept staged inbound reading photos into the private Librarian store.",
  "activation": {"onStartup": true},
  "contracts": {"tools": ["librarian_search", "librarian_session", "librarian_evidence", "librarian_review", "librarian_review_decision", "librarian_review_finalize"]},
  "configSchema": {
    "type": "object",
    "properties": {
      "repoRoot": {"type": "string", "minLength": 1},
      "stateRoot": {"type": "string", "minLength": 1},
      "deliveryMediaRoot": {"type": "string", "minLength": 1},
      "vaultRoot": {"type": "string", "minLength": 1},
      "visionModel": {"type": "string", "minLength": 1},
      "python": {"type": "string", "minLength": 1},
      "digitalSources": {
        "type": "object",
        "properties": {
          "ownerId": {"type": "string", "minLength": 1},
          "koodo": {
            "type": "object",
            "properties": {
              "sourceId": {"type": "string", "minLength": 1},
              "booksDb": {"type": "string", "minLength": 1},
              "notesDb": {"type": "string", "minLength": 1}
            },
            "required": ["sourceId", "booksDb", "notesDb"],
            "additionalProperties": false
          },
          "weread": {
            "type": "object",
            "properties": {
              "sourceId": {"type": "string", "minLength": 1},
              "pluginData": {"type": "string", "minLength": 1},
              "bookIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            },
            "required": ["sourceId", "pluginData", "bookIds"],
            "additionalProperties": false
          }
        },
        "required": ["ownerId"],
        "additionalProperties": false
      },
      "ownerMappings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "channelId": {"type": "string", "minLength": 1},
            "accountId": {"type": "string", "minLength": 1},
            "senderId": {"type": "string", "minLength": 1},
            "ownerId": {"type": "string", "minLength": 1}
          },
          "required": ["channelId", "accountId", "senderId", "ownerId"],
          "additionalProperties": false
        }
      }
    },
    "required": ["repoRoot", "stateRoot", "ownerMappings"],
    "additionalProperties": false
  }
}
