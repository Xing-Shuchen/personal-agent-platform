# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Runtime state (gate db, audit logs, per-agent run state)
#
# Every agent's runtime directory lives under var/ and holds real material:
# prepared ContextPacks, model inputs and event payloads. Listing agents one by
# one had already missed personal-historian, so ignore the whole tree and keep
# var/.gitkeep tracked instead.
/var/*
!/var/.gitkeep
agents/*/profile/var/

# Local secrets / editor
.env
.env.*
*.sqlite
*.sqlite3
.DS_Store

# Generated run artifacts
agents/*/runtime/reflect-*.json
agents/*/runtime/follow-*.json

# SQLite transient sidecars. The primary database is already covered by
# *.sqlite above; these files are recreated by SQLite and must not be tracked.
agents/*/runtime/*.sqlite-wal
agents/*/runtime/*.sqlite-shm
agents/*/runtime/*.sqlite-journal

# Local OpenClaw debugging exports can contain prompts, tool transcripts, and
# session metadata. Keep future project-level OpenClaw configuration trackable.
.openclaw/trajectory-exports/
